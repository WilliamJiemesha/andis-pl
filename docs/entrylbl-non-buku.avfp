function mydaflabel(){

  if (!wdlabel || wdlabel.closed) {
    wdlabel = window.open("rekaplblmobile.avfp?sh=<%=lcsh%>","_blank");
  }
  wdlabel.focus();
};


$(document).on('pagebeforeshow', '#page1', function(){ 
	$( "#popupEdit" ).popup({
        	afteropen: function( event, ui ) { $('#txtEntry').select().focus();}
	});
	$( "#popupTgl" ).popup({
        	afteropen: function( event, ui ) { $('#txtTgl').focus();}
	});

});    

$(window).focus(function() {
//    if (!document.hidden) {
        myloaddata(); // Refresh the page when it gets focus
//    }
});

function changeivc(lcven,lcivc,lcrecno){
   $('#txtIvcOld').val(lcivc);
   $('#txtVendor').val(lcven);
   $('#txtEntry').val(lcivc);
   $('#popupEdit').popup('open');

}

function changetgl(lcven,lcivc,lcrecno){
var ctgl;
   $('#txtIvcOld').val(lcivc);
   $('#txtVendor').val(lcven);
   ctgl = $('#tg'+lcrecno).text();
   ctgl = ctgl.substring(6,10)+'-'+ctgl.substring(3,5)+'-'+ctgl.substring(0,2);
   $('#txtTgl').val(ctgl);
   $('#popupTgl').popup('open');
}
  
function myupdateivc(){
   jQuery.ajaxSetup({async:false});
   $.get('editivcdata.avfp',{ ven: $('#txtVendor').val(), oivc : $('#txtIvcOld').val(), ivc: $('#txtEntry').val() }, function(data) {
 	$.get('looklblrhpdata.avfp',{ lcedit: 1 }, function(data){
                $('#popupEdit').popup('close');
		$('#thedata').empty();
		$('#thedata').append(data).trigger('create');
 	});	
   });
   jQuery.ajaxSetup({async:true});

   return false;
}

function myupdatetgl(){
var tisi;
   tisi = $('#txtTgl').val();
   tisi = tisi.substring(8,10)+'/'+tisi.substring(5,7)+'/'+tisi.substring(0,4);
   jQuery.ajaxSetup({async:false});
   $.get('editivcdata.avfp',{ ven: $('#txtVendor').val(), oivc : $('#txtIvcOld').val(), tgl: tisi }, function(data) {
 	$.get('looklblrhpdata.avfp',{ lcedit: 1 }, function(data){
                $('#popupTgl').popup('close');
		$('#thedata').empty();
		$('#thedata').append(data).trigger('create');
 	});	
   });
   jQuery.ajaxSetup({async:true});
   return false;
}

function copytovendor(){
	$('#txtVendor').val($('#lastven').text());
	$('#lastven').text('');
	lookvpodata()
	$('#txtBeli').focus();

}

function openvpodata(){
var curven, curph, nlven, tven;
  curph = $('#txtVendor').attr('placeholder');
  curven = (($('#txtVendor').val().trim().length>0)?$('#txtVendor').val().trim():((parseInt(curph)>0)?curph:''));
  const date2 = new Date($('#entrydate').val());
  const date1 = new Date($('#entrydate').val());
  date1.setDate(date1.getDate() - 7);
  tven = curven.toString();
  nlven = parseInt(tven.substring(2,3));
  nlven = ((nlven>6)?nlven-5:nlven);
  tven = tven.substring(0,2)+nlven.toString();
<%
        go top in veq
	do while !eof('veq')
%>	
	tven = ((tven=='<%=veq.vcasal%>')?'<%=veq.vcubah%>':tven);    // this is so spesific to Aneka Diesel Sinjai... hahaha
<%
           skip in veq
        enddo
%>
  $.get('visualpolook.avfp',{ tgl2 : date2.toISOString().slice(0, 10), tgl1 : date1.toISOString().slice(0, 10), vendor : tven }, function(data) {
		$('#resultgrid').empty();             
		$('#resultgrid').append(data).trigger('create');
		$('._nh').hide();
		$('#popupResult').popup('open');
	});
}


function lookvpodata(){
var curven, curph, nlven, tven;
  curph = $('#txtVendor').attr('placeholder');
  curven = (($('#txtVendor').val().trim().length>0)?$('#txtVendor').val().trim():((parseInt(curph)>0)?curph:''));
  const date2 = new Date($('#entrydate').val());
  const date1 = new Date($('#entrydate').val());
  date1.setDate(date1.getDate() - 7);
  tven = curven.toString();
  if (tven.length>0) {
    nlven = parseInt(tven.substring(2,3));
    nlven = ((nlven>6)?nlven-5:nlven);
    tven = tven.substring(0,2)+nlven.toString();
<%
        go top in veq
	do while !eof('veq')
%>	
	tven = ((tven=='<%=veq.vcasal%>')?'<%=veq.vcubah%>':tven);    // this is so spesific to Aneka Diesel Sinjai... hahaha
<%
           skip in veq
        enddo
%>
    $.get('visualpolook.avfp',{ tgl2 : date2.toISOString().slice(0, 10), tgl1 : date1.toISOString().slice(0, 10), vendor : tven }, function(data) {
		data = data.replace("myTable","myTableku");
		$('#thelook').empty();             
		$('#thelook').append(data).trigger('create');
		$('._nh').hide();
	});
  }
}

function puttoentry(lcBrg, lcMrk, lcTp) {
  if (lcBrg.trim().length>0) {
	$('#txtBarang').val(lcBrg);
	$('#txtMerk').val(lcMrk);
	$('#txtTipe').val(lcTp);
	myinfo();
	if ($('.ui-popup-active').length > 0) {
		clicklabel=true;
		$('#popupResult').popup('close');
	}else{
		$('#txtBeli').focus();
	}
  }
}

function saveperjurnal(uidx,tven){
var cjnl;
    cjnl = $('#iv'+uidx).text().replace(/&nbsp;|\u00a0/g, '');
    $.get('proseslbl.avfp',{ Proses_ID : "SAVELBL", ivc : cjnl, vendor : tven }, function(data) {
//	alert(data);
	myloaddata();
	});
}

</script>

