function getCookie(c_name)
{
var i,x,y,ARRcookies=document.cookie.split(";");
for (i=0;i<ARRcookies.length;i++)
  {
  x=ARRcookies[i].substr(0,ARRcookies[i].indexOf("="));
  y=ARRcookies[i].substr(ARRcookies[i].indexOf("=")+1);
  x=x.replace(/^\s+|\s+$/g,"");
  if (x==c_name)
    {
    return unescape(y);
    }
  }
}

function setCookie(c_name,value,exdays)
{
var exdate=new Date();
exdate.setDate(exdate.getDate() + exdays);
var c_value=escape(value) + ((exdays==null) ? "" : "; expires="+exdate.toUTCString());
document.cookie=c_name + "=" + c_value;
}

function chk_tglinput()
{

var tglinput=getCookie("tglinputlbl");
var lastivc=getCookie("lblnoivc");
var lddate = new Date();
var lcdate, xx1, lrdate, lcd1;

xx1 = lddate.toISOString();
lcdate = xx1.substring(0,4)+"-"+xx1.substring(5,7)+"-"+xx1.substring(8,10);
lrdate =  ((tglinput!=null && tglinput!=""&&<%=iif(lnrtemplbl>0,"true","false")%>) ? tglinput : lcdate);

document.getElementById("entrydate").value=lrdate;
}

function validatenumber(evt) {
  var theEvent = evt || window.event;
  var key = theEvent.keyCode || theEvent.which;
  if (key!=13){
  	key = String.fromCharCode( key );
  	var regex = /^[0-9\b]+$/;    // allow only numbers [0-9] 
  	if( !regex.test(key) ) {
  	  theEvent.returnValue = false;
    	  if(theEvent.preventDefault) theEvent.preventDefault();
  	}
  }
}

function testempty(cpar1)
{
  return (cpar1!=null) && (cpar1.trim()!='')
}

function OnSubmitForm()
{
var ik,myf;
var ctest = String;
var lcMerk = document.form.txtMerk.value.trim();
var lcTipe = document.form.txtTipe.value.trim();
var lcBarang = document.form.txtBarang.value.trim();
var lcVendor = document.form.txtVendor.value.trim();
var lcBeli = document.form.txtBeli.value.trim();
var lcJual = document.form.txtJual.value.trim();
var lcJumlah=document.form.txtJumlah.value.trim();
var lcQCetak=document.form.txtQCetak.value.trim();
var lcivc = document.form.txtIvc.value.trim().toUpperCase();
var lcinv = document.form.txtInv.value.trim().toUpperCase();
var hjblerr = false;

lcJumlah = (lcJumlah.length==0?lcQCetak:lcJumlah);
//lcivc = (((lcVendor=='993')||(lcivc.length==0))?'---':lcivc);


if ((lcJual.trim().length+lcBeli.trim().length)>0) {
   $.ajaxSetup({async:false});
   $.get('isbjok.avfp',{ hjl: lcJual , hbl: lcBeli }, function(data) {
 	if (data.length==0){ 
		$('#txtBeli').addClass('isErr'); 
		$('#txtJual').addClass('isErr');
		hjblerr = true;
	}else{
		$('#txtBeli').removeClass('isErr'); 
		$('#txtJual').removeClass('isErr');
	}
	});
   $.ajaxSetup({async:true});
}

if (lcMerk.length==0)
{  lcMerk = document.form.txtMerk.placeholder.trim(); }
if (lcTipe.length==0)
{ lcTipe = document.form.txtTipe.placeholder.trim(); }
if (lcBarang.length==0)
{ lcBarang = document.form.txtBarang.placeholder.trim();}
if (lcVendor.length==0)
{ lcVendor = document.form.txtVendor.placeholder.trim();}

 if (document.pressed == 'Simpan')
 { 
     ik = isNaN(document.form.txtVendor.value); 
     if (ik==true)
     {
         swal({   title: "Isian Supplier harus berupa Angka",   text: "",   type: "error",   confirmButtonText: "Ok" }); return false;
     }
    else
     {
        if (lcVendor.length == 0)
        { swal({   title: "Supplier Harus Diisi",   text: "",   type: "error",   confirmButtonText: "Ok" }); return false;}
        else {  
        if (lcBarang.length == 0)
        { swal({   title: "Nama Barang Harus Diisi",   text: "",   type: "error",   confirmButtonText: "Ok" }); return false;}
        else  { 
        if (lcMerk.length == 0)
        { swal({   title: "Merk Harus Diisi",   text: "",   type: "error",   confirmButtonText: "Ok" }); return false;}
        else {
        if (lcTipe.length == 0)
        { swal({   title: "Tipe Harus Diisi",   text: "",   type: "error",   confirmButtonText: "Ok" }); return false;}
        if (lcBeli.length == 0)
        { swal({   title: "Kode Beli Harus Diisi",   text: "",   type: "error",   confirmButtonText: "Ok" }); return false;}
        else {
        if (lcJual.length ==0)
        { swal({   title: "Kode Jual Harus Diisi",   text: "",   type: "error",   confirmButtonText: "Ok" }); return false;}
	else {
        if (hjblerr)
        { swal({   title: "Harga Beli dan Harga Jual Tidak Sesuai",   text: "",   type: "error",   confirmButtonText: "Ok" }); return false;}
        else {
        if (lcQCetak.length ==0)
        { swal({   title: "Jumlah Cetak Harus Diisi",   text: "",   type: "error",   confirmButtonText: "Ok" }); return false;}
        else { 
	 if ($('#nbBridge').is(':checked') && !nbSyncNonBukuBeforeSubmit()) { return false; }
	 setCookie("tglinputlbl",document.form.entrydate.value,1);   
	 setCookie("lblnoivc",document.form.txtIvc.value,1);   
	 v1 = $('#txtJumlah').val();
	 myf = (($('#fo').is(':checked')||(v1.indexOf('^')>=0))?8:0) + (($('#ns').is(':checked')||(v1.indexOf('&')>=0))?4:0) + (($('#np').is(':checked')||(v1.indexOf('*')>=0))?2:0) + (($('#nq').is(':checked')||(v1.indexOf('(')>=0))?1:0);
	 myrem = $('#txtrem').val().replace(/\#/g, "|");
	 document.form.action = "<%=JustPath(oProp.ScriptPath)+[/proseslbl]+oProp.Ext%>"+"?action_id=<%=JustPath(oProp.ScriptPath)+[/entrylbl]+oProp.Ext%>&proses_id=save&vendor="+lcVendor+"&Barang="+lcBarang+"&tipe="+lcTipe+"&jual="+lcJual+"&beli="+lcBeli+"&Jumlah="+lcJumlah+"&Cetak="+lcQCetak+"&Merk="+lcMerk+"&nowdate="+document.form.entrydate.value+"&myf="+myf+"&ivc="+lcivc+"&inv="+lcinv+"&buf="+$('#txtbuffer').val()+"&rem="+myrem+"&sh=<%=lcsh%>";
        }}}}}}}
   }
 }
 else
 {
	document.form.action = "<%=JustPath(oProp.ScriptPath)+[/rekaplblmobile]+oProp.Ext%>?sh=<%=lcsh%>";
  }
}

