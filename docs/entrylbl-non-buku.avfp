<%
    ErrMsg=''
    do case 
         case lnPAlert=1
                  ErrMsg = 'Kode Harga Beli Salah !!'
         case lnPAlert=2
                  ErrMsg = 'Kode Harga Jual Salah !!'
         case lnPAlert=3
                  ErrMsg = 'Ada Kesalahan Data !!'
    endcase
 %>
<%
if !empty(ErrMsg)

%>
<script language="javascript">
swal({   title: "<%=ErrMsg%>",   text: "",   type: "error",   confirmButtonText: "Ok" });
</script>
<%
    endif
%>


<form name="form" id="myForm" method="post"  data-ajax ="false" onsubmit="return OnSubmitForm();" autocomplete="off">
<div data-role="main" class="ui-content" >
<div class='ui-grid-a'>
<div class='ui-block-a' style='max-width:600px;'>
<table style="text-align: left; width: 740px; height: 125px;" border="0" cellpadding="1" cellspacing="0">
<tbody>
<tr>
<td style="height: 25px;<%=iif(lnrtemplbl>0,'','color:red;')%>">Tanggal</td>
<td style="height: 25px;">
<div class="ui-block-b" style="width:40%">
<%    lcdate=dtos(date()) %>
     <input type="date" name="entrydate" id="entrydate" value="<%=left(lcdate,4)+'-'+substr(lcdate,5,2)+'-'+right(lcdate,2)%>" onchange="lookvpodata()" />
</div>
<script>chk_tglinput()</script>
</td>
</tr>


<tr>
<td style="height: 25px;color:#64e764">Nota #</td>
<td style="height: 25px;">
<div class="ui-grid-a">
<div class="ui-block-a" style="margin-left:2px;width:50%">
<input name="txtIvc" id="txtIvc" style="text-transform:uppercase;" maxlength="15" value="" size="15" placeholder="">
<input name="txtIvcOld" id="txtIvcOld" style="display:none">
</div></div>
</td>
</td>
</tr>
<script>
<% if lnrtemplbl>0 %>
  ccc = getCookie("lblnoivc");
  document.getElementById("txtIvc").value=((ccc!=null)?ccc:"");
<% endif %>
</script>


<tr>
<td style="width: 70px; height: 25px;">Supplier</td>
<td style="width: 247px; height: 25px;">
<div class="ui-grid-a" >
<div class="ui-block-a" style="width:80px;margin-left:4px;">
	<input type="tel" name="txtVendor" id="txtVendor"  maxlength="3" onKeyPress="validatenumber(event);" placeholder="<%=iif(isnull(lcPVendor),'',lcPVendor)%>" data-clear-btn="true" onchange="lookvpodata()">
</div>
<div class="ui-block-b" style="width:70%;margin-left:5px;">
<fieldset data-role="controlgroup" data-type="horizontal" style='margin-top:5px'; >
	<input type="checkbox" id="fo" name="fo" data-mini="true" tabindex=-1>
	<label for="fo" title='Minta Foto Barang'>
	<span class="fa-stack" style='cursor:pointer;'><i class="fa-solid fa-camera" style='color:white;font-size:22px;'></i></span>
	</label>
	<input type="checkbox" id="ns" name="ns" data-mini="true" tabindex=-1>
	<label for="ns" title='Jangan Simpan Label setelah cetak'>
	<span class="fa-stack" style='cursor:pointer;'><i class="fa-solid fa-floppy-disk fa-stack-1x" style='color:white;font-size:17px;'></i><i class="fa-solid fa-ban fa-stack-2x mytomato"></i></span>
	</label>
	<input type="checkbox" id="np" name="np" data-mini="true" tabindex=-1>
	<label for="np" title='Jangan Cetak Label'>
	<span class="fa-stack" style='cursor:pointer;'><i class="fa-solid fa-print fa-stack-1x" style='color:white;font-size:17px;'></i><i class="fa-solid fa-ban fa-stack-2x mytomato"></i></span>
	</label>
	<input type="checkbox" id="nq" name="nq" data-mini="true" tabindex=-1>
	<label for="nq" title='Jangan Cetak QRCode'>
	<span class="fa-stack" style='cursor:pointer;'><i class="fa-solid fa-barcode fa-stack-1x" style='color:white;font-size:17px;'></i><i class="fa-solid fa-ban fa-stack-2x mytomato"> style=</i></span>
	</label>
	<input type="checkbox" id="nbBridge" name="nbBridge" data-mini="true" tabindex=-1 onchange="nbBridgeClicked()">
	<label for="nbBridge" title='Kirim ke Non Buku Project'>
	<span class="fa-stack" style='cursor:pointer;'><i class="fa-solid fa-file-lines fa-stack-1x" style='color:white;font-size:17px;'></i><i class="fa-solid fa-arrows-rotate fa-stack-2x" style='color:#ffd75a;font-size:13px;'></i></span>
	</label>
</fieldset>
</div>
</div>
</td>
<td style="width:200px;height:25px;"></td>
</tr>

<tr>
<td style="height: 25px;">Barang / Merk</td>
<td style="height: 25px;">
<div class="ui-grid-b">
<div class="ui-block-a" style="width:145px;margin-left:2px;">
	<input type="text" name="txtBarang" id="txtBarang" style="text-transform:uppercase;" maxlength="10" value=""  placeholder="<%=iif(isnull(lcPBarang),'',lcPBarang)%>" data-clear-btn="true" >
</div>
<div class="ui-block-b" style="width:2%"></div>
<div class="ui-block-c" style="width:135px">
	<input type="text" name="txtMerk" id="txtMerk" style="text-transform:uppercase;" maxlength="5" value="" placeholder="<%=iif(isnull(lcPMerk),'',lcPMerk)%>" data-clear-btn="true" >
</div>
</td>
</tr>

<tr>
<td style="width: 61px; height: 39px;">Tipe</td>
<td style="width: 447px; height: 39px;" >
<div  class="ui-grid-b" >
<div class="ui-block-a" style="width:120px;margin-top:.2em;margin-left:2px;">
 <input name="txtTipe" id="txtTipe" style="text-transform:uppercase;" maxlength="7" value="" size="7"  placeholder="<%=iif(isnull(lcPTipe),'',lcPTipe)%>" data-clear-btn="true" >
</div>
<div class="ui-block-b" style="width: 39px;margin-top: -2px;">
 <a href="javascript:myinfo()" style="margin-top:15px;" class="ui-btn ui-icon-search ui-btn-icon-notext ui-corner-all" ></a>
</div>
<div lcass="ui-block-c" style="margin-top: 18px;">
<span style='color:gray;cursor:pointer;margin-left:3px;' id='lastven' title="Klik untuk salin ke Isian Supplier" onclick="copytovendor()"></span>
</div>
</div>
</td>

<tr>
<td style="width: 61px; height: 39px;">Beli / Jual</td>

<td style="height: 25px;">
<div class="ui-grid-b">
<div class="ui-block-a" style="width:35%;margin-left:2px;">
<input name="txtBeli" id="txtBeli" style="text-transform:uppercase;color:<%=iif(lnPAlert=1 .or. lnPAlert=3,'#FF7500','white')%>" maxlength="20" value="<%=iif(lnPAlert>0,lcPHBeli,'')%>" size="20"  data-clear-btn="true" placeholder="" onchange="onhbeli()">
</div>
<div class="ui-block-b" style="width:5%"> </div>
<div class="ui-block-c" style="width:35%">
<input name="txtJual" id="txtJual" style="text-transform:uppercase;color:<%=iif(lnPAlert=2 .or. lnPAlert=3,'#FF7500','white')%>" maxlength="8" value="<%=iif(lnPAlert>0,lcPHJual,'')%>" size="8" data-clear-btn="true" placeholder="" >
</div>
</div>
</td>

</tr>


<tr>
<td style="width: 61px; height: 39px;">Cetak / (QtyBrg)</td>
<td style="height: 39px;">
<div  class='ui-grid-c'>
<div  class="ui-block-a" style="width:25%;margin-left:2px;"><input type="tel" name="txtQCetak" id="txtQCetak" value="<%=iif(lnPAlert>0,lcPCetak,'')%>" maxlength="4" pattern="[\s|-,0-9]{1,3}" onKeyPress="validatenumber(event);" data-clear-btn="true"  /></div>
<div  class="ui-block-b" style="width:10%;text-align:center;margin-top: 1em;">(</div>
<div  class="ui-block-c" style="width:25%;"><input type="tel" name="txtJumlah" id="txtJumlah" value="<%=iif(lnPAlert>0,lcPQty,'')%>" maxlength="4" pattern="[\s|-,0-9]{1,3}" data-clear-btn="true" title="Sisipkan '*' supaya label tidak tercetak"/></div>
<div  class="ui-block-d" style="width:10%;text-align:center;margin-top: 1em;">)</div>
</div>
</td>
</tr>

<tr>
<td style="width: 61px; height: 39px;">Buffer / Remark</td>
<td style="height: 39px;">
<div class="ui-grid-c">
<div class="ui-block-a" style="width:80px;margin-left:2px;">
<input type="tel" name="txtbuffer" id="txtbuffer" value="" maxlength="3" pattern="[\s|-,0-9]{1,3}" onKeyPress="validatenumber(event);" data-clear-btn="true" />
</div>
<div class="ui-block-b" style="width:10px"></div>
<div class="ui-block-c" style="width:360px;margin-left:2px;">
<textarea name="txtrem" id="txtrem" value="" style="text-transform:uppercase;max-height:3em !important;" maxlength="60" data-clear-btn="true" ></textarea>
</div>
</td>
</tr>


<tr>
<td style="height: 25px;color:#64e764">Inven #</td>
<td style="height: 25px;">
<div class="ui-grid-b">
  <div class="ui-block-a" style="margin-left:2px;width:50%">
   <input name="txtInv" id="txtInv" style="text-transform:uppercase;" maxlength="20" value="" size="20" placeholder="" tabindex=-1 readonly >
  </div>
  <div class="ui-block-b">
    <a href="javascript:myinv()" style="margin-top:-9px;" class="ui-btn ui-icon-search ui-btn-icon-notext ui-corner-all" ></a>
  </div></div>
</td>
</td>
</tr>

<tr>
<td style="height: 25px;color:#ffd75a">Stock</td>
<td style="height: 25px;">
<div class="ui-grid-b">
  <div class="ui-block-a" style="margin-left:2px;width:50%">
   <input name="txtStock" id="txtStock" style="text-transform:uppercase;" maxlength="60" value="" size="20" placeholder="" autocorrect="off" autocomplete="off">
  </div>
  <div class="ui-block-b">
    <a href="javascript:nbSearchStock()" style="margin-top:-9px;background:#ffd75a;border-color:#ffd75a;color:#111;" class="ui-btn ui-icon-search ui-btn-icon-notext ui-corner-all" title="Cari Stock Non Buku"></a>
  </div></div>
</td>
</tr>

</tbody>
</table>
<br>

<table style="text-align: left; width:380px; height: 20px;" border="0" cellpadding="3" cellspacing="1">
<thead></thead><tr></tr>
<tbody>
<tr>
<td style="text-align: center; height: 39px;">
<input type="submit" id="btSimpan" onclick="document.pressed='Simpan'" value="Daftarkan" data-icon="check" data-iconpos="top" data-mini="true" data-inline="true">
</td>	    
